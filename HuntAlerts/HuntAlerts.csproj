<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.SDK/15.0.0">
    <PropertyGroup>
        <Version>1.4.1.7</Version>
        <Name>HuntAlerts</Name>
        <Author>Asuna, Rein</Author>
        <Punchline>Notifies you when and where hunts are happening</Punchline>
        <Description>Displays incoming hunt train and S rank marks appear from various hunt networks.
        Supports NA/EU/OCE/JP</Description>
        <RepoUrl>https://github.com/scrxtchy/</RepoUrl>
        <Tags>hunt;train;tour;rank</Tags>
        <IconUrl>https://v2.xivapi.com/api/asset/ui/icon/068000/068939.tex?format=png</IconUrl>
        <AcceptsFeedback>False</AcceptsFeedback>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ECommons" Version="3.2.1.22" />
      <PackageReference Include="ECommons.IPC" Version="1.0.0.24" />
      <PackageReference Include="SocketIOClient" Version="3.1.1" />
      <PackageReference Include="NAudio" Version="2.2.1" />
    </ItemGroup>
    
</Project>
